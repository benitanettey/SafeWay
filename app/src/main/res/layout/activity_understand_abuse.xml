<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background">

    <!-- Top Gradient Accent Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/section_divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/header_understand_abuse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back_understand_abuse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/neutral_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/understand_abuse_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/secondary_background"
        app:layout_constraintTop_toBottomOf="@id/header_understand_abuse"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/understand_abuse_intro"
                android:textColor="@color/neutral_text"
                android:textSize="14sp"
                android:lineHeight="20sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <!-- Physical Abuse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abuse_physical_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abuse_physical_description"
                    android:textColor="@color/neutral_text"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btn_log_physical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/log_incident"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent" />
            </LinearLayout>

            <!-- Verbal Abuse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abuse_verbal_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abuse_verbal_description"
                    android:textColor="@color/neutral_text"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btn_log_verbal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/log_incident"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent" />
            </LinearLayout>

            <!-- Financial Abuse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abuse_financial_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abuse_financial_description"
                    android:textColor="@color/neutral_text"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btn_log_financial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/log_incident"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent" />
            </LinearLayout>

            <!-- Sexual Abuse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abuse_sexual_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abuse_sexual_description"
                    android:textColor="@color/neutral_text"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btn_log_sexual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/log_incident"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent" />
            </LinearLayout>

            <!-- Psychological Abuse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abuse_psychological_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abuse_psychological_description"
                    android:textColor="@color/neutral_text"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btn_log_psychological"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/log_incident"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_nav_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
