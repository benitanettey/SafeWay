<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background">

    <!-- Top Gradient Accent Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/section_divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_records"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:tint="@color/neutral_text"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:text="@string/private_records_title"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:gravity="center" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/secondary_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <!-- Alert Notification Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_elevated_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/pulse_dot" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_alert_banner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/records_alert_banner_default"
                    android:textSize="13sp"
                    android:textColor="@color/highlight_accent"
                    android:lineHeight="18sp" />

            </LinearLayout>

            <!-- Search, Filter, Sort Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_elevated_background"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/edit_text_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:tint="@color/neutral_muted"
                        android:contentDescription="@string/search_records_hint" />

                    <EditText
                        android:id="@+id/et_search_records"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="@string/search_records_hint"
                        android:inputType="text"
                        android:padding="8dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/neutral_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Filter Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_by"
                        android:textSize="11sp"
                        android:textColor="@color/neutral_text"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/sp_filter_severity"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/edit_text_bg"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                    <Spinner
                        android:id="@+id/sp_filter_voice"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/edit_text_bg"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                    <Spinner
                        android:id="@+id/sp_sort_records"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_bg"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_empty_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:padding="24dp"
                android:gravity="center"
                android:text="@string/no_records_yet"
                android:textColor="@color/neutral_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5" />

            <!-- Records RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Load More Button -->
            <Button
                android:id="@+id/btn_load_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/button_secondary_bg"
                android:text="@string/load_more"
                android:textColor="@color/highlight_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:minHeight="44dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone" />

            <!-- Export Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_share"
                        android:tint="@color/section_label"
                        android:contentDescription="@string/export_for_legal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/export_for_legal"
                        android:textSize="12sp"
                        android:textColor="@color/section_label"
                        android:letterSpacing="0.14"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/export_legal_description"
                    android:textSize="13sp"
                    android:textColor="@color/neutral_text"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_export_csv"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:gravity="center"
                        android:background="@drawable/button_secondary_bg"
                        android:text="@string/export_csv"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_export_pdf"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:gravity="center"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/button_secondary_bg"
                        android:text="@string/export_pdf"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_export_encrypted"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:gravity="center"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/button_secondary_bg"
                        android:text="@string/export_encrypted"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_nav_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
