<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background">

    <!-- Top Gradient Accent Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/section_divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_log"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:tint="@color/neutral_text"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:text="@string/log_incident_title"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:gravity="center" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/secondary_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <!-- Voice Recording Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_elevated_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btn_record"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/record_button_bg"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_mic"
                            android:tint="@color/highlight_accent"
                            android:layout_gravity="center"
                            android:contentDescription="@string/voice_note" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tv_record_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/voice_note"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/tv_record_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/tap_to_record"
                                android:textSize="11sp"
                                android:textColor="@color/neutral_text" />

                            <TextView
                                android:id="@+id/tv_record_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/record_time_default"
                                android:textColor="@color/highlight_accent"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_preview_recording"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/button_secondary_bg"
                            android:contentDescription="@string/play_voice_note_preview"
                            android:src="@drawable/ic_play"
                            android:visibility="gone"
                            android:tint="@color/highlight_accent" />

                        <ImageButton
                            android:id="@+id/btn_delete_recording"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/button_secondary_bg"
                            android:contentDescription="@string/delete_voice_note"
                            android:src="@drawable/ic_delete"
                            android:visibility="gone"
                            android:tint="@color/emergency_red" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_waveform"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Media Evidence Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_elevated_background"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="@color/section_label"
                        android:contentDescription="@string/add_evidence" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/add_evidence"
                        android:textColor="@color/section_label"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_take_photo"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:background="@drawable/button_secondary_bg"
                        android:text="@string/take_photo"
                        android:textColor="@color/highlight_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:drawableStart="@android:drawable/ic_menu_camera"
                        android:drawablePadding="6dp" />

                    <Button
                        android:id="@+id/btn_take_video"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/button_secondary_bg"
                        android:text="@string/record_video"
                        android:textColor="@color/highlight_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:drawableStart="@android:drawable/ic_menu_gallery"
                        android:drawablePadding="6dp" />
                </LinearLayout>

                <!-- Photo Status & Preview -->
                <TextView
                    android:id="@+id/tv_photo_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/no_photo_attached"
                    android:textColor="@color/neutral_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_delete_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/button_secondary_bg"
                    android:minHeight="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/delete_photo"
                    android:textColor="@color/emergency_red"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_video_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/no_video_attached"
                    android:textColor="@color/neutral_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_delete_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/button_secondary_bg"
                    android:minHeight="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/delete_video"
                    android:textColor="@color/emergency_red"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="10dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/card_background"
                    android:contentDescription="@string/photo_preview"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_preview_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/button_secondary_bg"
                    android:text="@string/preview_video"
                    android:textColor="@color/highlight_accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- What Happened Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/what_happened"
                android:textSize="12sp"
                android:textColor="@color/section_label"
                android:letterSpacing="0.14"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="@drawable/edit_text_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:hint="@string/describe_incident"
                android:gravity="top|start"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/neutral_muted"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:inputType="textMultiLine"
                android:layout_marginBottom="20dp" />

            <!-- Incident Type Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_type"
                    android:textSize="12sp"
                    android:textColor="@color/section_label"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.2"
                    android:background="@drawable/section_divider"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_physical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_physical"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_verbal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_verbal"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_financial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_financial"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_sexual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_sexual"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_neglect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incident_neglect"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

            </LinearLayout>

            <!-- Severity Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/severity"
                    android:textSize="12sp"
                    android:textColor="@color/section_label"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.2"
                    android:background="@drawable/section_divider"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sev_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/severity_low"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sev_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/severity_medium"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sev_high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/severity_high"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sev_crisis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/severity_crisis"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/card_background"
                    app:chipStrokeColor="@color/border_dark"
                    app:chipStrokeWidth="1dp"
                    android:checkable="true" />

            </LinearLayout>

            <!-- Location Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location"
                    android:textSize="12sp"
                    android:textColor="@color/section_label"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.2"
                    android:background="@drawable/section_divider"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="50dp"
                android:hint="@string/location_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/neutral_muted"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="20dp" />

            <!-- Who Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/who_optional"
                    android:textSize="12sp"
                    android:textColor="@color/section_label"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.2"
                    android:background="@drawable/section_divider"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_who"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="50dp"
                android:hint="@string/who_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/neutral_muted"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="28dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btn_save_incident"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_primary_bg"
                android:text="@string/save_to_journal"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="2dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_nav_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
